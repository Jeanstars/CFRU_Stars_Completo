+#ifdef FLAG_RANDOM_TRAINER_POOL
+//Used by FLAG_RANDOM_TRAINER_POOL and FLAG_RANDOM_GIVEMON_POOL.
+//Fully overwrites species/moves/held item/nature on an already-created mon using a
+//random entry from gRandomTrainerPool (include/new/random_trainer_pool_full.h),
+//then recalculates its stats and heals it back to full.
+static void ApplyRandomTrainerPoolToMon(struct Pokemon* mon)
+{
+	const struct RandomTrainerPoolMon* entry = &gRandomTrainerPool[Random() % NELEMS(gRandomTrainerPool)];
+	u8 speciesName[POKEMON_NAME_LENGTH + 1];
+	u8 j;
+
+	SetMonData(mon, MON_DATA_SPECIES, &entry->species);
+	SetMonData(mon, MON_DATA_HELD_ITEM, &entry->item);
+
+	//Fix nickname - CreateMon already baked in the ORIGINAL Trainer species' name as
+	//the nickname, and changing MON_DATA_SPECIES above doesn't update that text on its own
+	GetSpeciesName(speciesName, entry->species);
+	SetMonData(mon, MON_DATA_NICKNAME, speciesName);
+
+	//Fix teraType - it was already rolled earlier in CreateNPCTrainerParty based on the
+	//ORIGINAL Trainer species' typing, so re-roll it now based on this mon's NEW typing
+	{
+		u8 type1 = gBaseStats[entry->species].type1;
+		u8 type2 = gBaseStats[entry->species].type2;
+
+		if (Random() % 100 < 2) //2% chance to get a fully random teraType, same odds used above
+			mon->teraType = GetRandomTeraType();
+		else if (type1 == type2 || type2 == TYPE_MYSTERY || type2 == TYPE_BLANK)
+			mon->teraType = type1;
+		else
+			mon->teraType = (Random() & 1) ? type1 : type2;
+	}
+
+	for (j = 0; j < MAX_MON_MOVES; ++j)
+	{
+		mon->moves[j] = entry->moves[j];
+		mon->pp[j] = GetTrainerMonMovePP(entry->moves[j], j);
+	}
+	mon->ppBonuses = GetTrainerMonMovePPBonus();
+
+	//Random ability slot (0 or 1); GiveMonNatureAndAbility re-rolls personality until it matches the requested nature
+	GiveMonNatureAndAbility(mon, entry->nature, Random() % 2, IsMonShiny(mon), FALSE, FALSE);
+
+	CalculateMonStatsNew(mon);
+	HealMon(mon);
+}
+#endif
+
 static u16 TryReplaceNormalTrainerSpecies(u16 species, unusedArg u16 trainerId)
 {
+	#ifdef FLAG_RANDOM_TRAINER_TEAM
+	if (FlagGet(FLAG_RANDOM_TRAINER_TEAM))
+	{
+		//Picks a random, non-repeating (within the same Trainer's team) species from
+		//gRandomTrainerSpeciesPool (src/Tables/random_trainer_pool.h). Level/item/moves
+		//for this slot are untouched - only the species set here changes.
+		static u16 sLastRandomTeamTrainerId = 0xFFFF;
+		static u16 sUsedRandomSpecies[PARTY_SIZE];
+		static u8 sUsedRandomSpeciesCount;
+		u16 newSpecies;
+		u8 tries, k;
+
+		if (trainerId != sLastRandomTeamTrainerId)
+		{
+			sLastRandomTeamTrainerId = trainerId;
+			sUsedRandomSpeciesCount = 0;
+		}
+
+		for (tries = 0; tries < 50; ++tries) //50 tries is plenty given the pool has hundreds of species
+		{
+			newSpecies = gRandomTrainerSpeciesPool[Random() % NELEMS(gRandomTrainerSpeciesPool)];
+
+			for (k = 0; k < sUsedRandomSpeciesCount; ++k)
+			{
+				if (sUsedRandomSpecies[k] == newSpecies)
+					break;
+			}
+
+			if (k == sUsedRandomSpeciesCount) //Wasn't already used on this team
+				break;
+		}
+
+		if (sUsedRandomSpeciesCount < PARTY_SIZE)
+			sUsedRandomSpecies[sUsedRandomSpeciesCount++] = newSpecies;
+
+		return newSpecies;
+	}
+	#endif
+
 	#ifdef UNBOUND
 	extern u16 TryReplaceUnboundNormalTrainerSpecies(u16 species, u16 trainerId);
 	return TryReplaceUnboundNormalTrainerSpecies(species, trainerId);
@@ -4136,9 +4278,38 @@ u8 ScriptGiveMon(u16 species, u8 level, u16 item, unusedArg u32 unused1, unusedA
 	u8 sentToPc;
 	struct Pokemon mon;
 
+	#ifdef FLAG_RANDOM_GIVEMON_POOL
+	//Replace the species/item that were about to be given with a random entry from gRandomTrainerPool.
+	//Level is kept as originally scripted; moves/nature are set below, same as FLAG_RANDOM_TRAINER_POOL.
+	bool8 useRandomGivemonEntry = FlagGet(FLAG_RANDOM_GIVEMON_POOL);
+	const struct RandomTrainerPoolMon* randomGivemonEntry = NULL;
+	if (useRandomGivemonEntry)
+	{
+		randomGivemonEntry = &gRandomTrainerPool[Random() % NELEMS(gRandomTrainerPool)];
+		species = randomGivemonEntry->species;
+		item = randomGivemonEntry->item;
+	}
+	#endif
+
 	CreateMon(&mon, species, level, 32, 0, 0, 0, 0);
 	SetMonData(&mon, MON_DATA_HELD_ITEM, &item);
 
+	#ifdef FLAG_RANDOM_GIVEMON_POOL
+	if (useRandomGivemonEntry)
+	{
+		u8 j;
+		for (j = 0; j < MAX_MON_MOVES; ++j)
+		{
+			mon.moves[j] = randomGivemonEntry->moves[j];
+			mon.pp[j] = GetTrainerMonMovePP(randomGivemonEntry->moves[j], j);
+		}
+		mon.ppBonuses = GetTrainerMonMovePPBonus();
+
+		GiveMonNatureAndAbility(&mon, randomGivemonEntry->nature, GetMonData(&mon, MON_DATA_PERSONALITY, NULL) & 1, IsMonShiny(&mon), FALSE, FALSE);
+		CalculateMonStatsNew(&mon);
+	}
+	#endif
+
 	#ifdef GIVEPOKEMON_BALL_HACK
 	if (ballType != 0)
 		mon.pokeball = ballType;
