+//MODE_PEEK: "copy bytes [offset, offset + length) of the block whose live address is 'live' into 'dest'".
+//The list ends with live == NULL. It is passed by pointer (this build has no writable globals).
+struct PeekRequest
+{
+	const void* live;
+	u16 offset;
+	u16 length;
+	u8* dest;
+};
